<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\OhMyBot.Contracts\OhMyBot.Contracts.csproj" />
      <ProjectReference Include="..\OhMyBot.Core\OhMyBot.Core.csproj" />
      <ProjectReference Include="..\OhMyBot.Core.Host\OhMyBot.Core.Host.csproj" />
      <ProjectReference Include="..\OhMyBot.Plugin.Abstractions\OhMyBot.Plugin.Abstractions.csproj" />
      <ProjectReference Include="..\OhMyBot.QQGateway\OhMyBot.QQGateway.csproj" />
      <ProjectReference Include="..\OhMyBot.TelegramGateway\OhMyBot.TelegramGateway.csproj" />
      <ProjectReference Include="Fixtures\PluginDependencyA\OhMyBot.Tests.PluginDependencyA.csproj"
                        ReferenceOutputAssembly="false" />
      <ProjectReference Include="Fixtures\PluginDependencyB\OhMyBot.Tests.PluginDependencyB.csproj"
                        ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
      <PackageReference Include="MSTest" Version="4.2.3" />
    </ItemGroup>

    <ItemGroup>
      <None Include="appsettings.Test.template.json" />
      <Compile Remove="Fixtures/**/*.cs" />
      <PluginFixtureProject Include="Fixtures\PluginDependencyA\OhMyBot.Tests.PluginDependencyA.csproj" />
      <PluginFixtureProject Include="Fixtures\PluginDependencyB\OhMyBot.Tests.PluginDependencyB.csproj" />
    </ItemGroup>

    <Target Name="BuildPluginRuntimeFixtures" BeforeTargets="CopyPluginRuntimeFixtures">
      <MSBuild Projects="@(PluginFixtureProject)"
               Targets="Build"
               Properties="Configuration=$(Configuration)" />
    </Target>

    <Target Name="CopyPluginRuntimeFixtures" AfterTargets="Build" DependsOnTargets="BuildPluginRuntimeFixtures">
      <PropertyGroup>
        <_PluginFixtureRoot>$(OutDir)PluginFixtures</_PluginFixtureRoot>
      </PropertyGroup>
      <MakeDir Directories="$(_PluginFixtureRoot)\A;$(_PluginFixtureRoot)\B" />
      <Copy SourceFiles="$(MSBuildProjectDirectory)\..\build\OhMyBot.Tests.PluginDependencyA\bin\$(Configuration)\net10.0\OhMyBot.Tests.PluginDependencyA.dll"
            DestinationFiles="$(_PluginFixtureRoot)\A\Plugin.dll" />
      <Copy SourceFiles="$(MSBuildProjectDirectory)\..\build\OhMyBot.Tests.PluginDependencyB\bin\$(Configuration)\net10.0\OhMyBot.Tests.PluginDependencyB.dll"
            DestinationFiles="$(_PluginFixtureRoot)\B\Plugin.dll" />
    </Target>

</Project>
